# ============================================================
# Configuration du Meshtastic Météo Bot
# Copier ce fichier en .env et ajuster les valeurs
# ============================================================

# --- Réseau utilisé ---
# Valeurs possibles : "auto", "meshtastic" ou "meshcore"
# "auto" détecte le firmware du matériel connecté au démarrage.
MESH_NETWORK=auto

# --- Connexion Meshtastic ---
# Type de connexion : "serial", "tcp" ou "ble"
MESHTASTIC_CONNECTION_TYPE=serial

# Chemin du port série (si CONNECTION_TYPE=serial)
# Windows : COM3, COM4, etc.
# Linux : /dev/ttyUSB0 ou /dev/ttyACM0
# macOS : /dev/cu.usbmodem...
MESHTASTIC_SERIAL_PORT=COM3

# Adresse IP du nœud (si CONNECTION_TYPE=tcp)
MESHTASTIC_TCP_HOST=192.168.1.100

# --- Connexion MeshCore ---
# Type : "serial", "tcp" ou "ble"
MESHCORE_CONNECTION_TYPE=serial
MESHCORE_SERIAL_PORT=COM3
MESHCORE_BAUDRATE=115200
MESHCORE_TCP_HOST=192.168.1.100
MESHCORE_TCP_PORT=4000
# Adresse BLE facultative (laisser vide pour le scan)
MESHCORE_BLE_ADDRESS=
# PIN BLE facultatif
MESHCORE_BLE_PIN=

# --- Paramètres météo (Défaut : Normandie / Caen) ---
# Département par défaut (code INSEE, ex: 14 pour le Calvados)
DEFAULT_DEPARTMENT=14

# Latitude et longitude par défaut (si pas de GPS sur le nœud)
DEFAULT_LATITUDE=49.1833
DEFAULT_LONGITUDE=-0.37

# --- Canaux Meshtastic ---
# Numéro du canal sur lequel diffuser la météo (0 = canal primaire)
BROADCAST_CHANNEL=0

# Numéro du canal pour les alertes urgentes (peut être le même)
ALERT_CHANNEL=0

# --- Clé API Météo-France (optionnel, pour l'API publique officielle) ---
# Obtenir une clé sur : https://portail-api.meteofrance.fr
METEOFRANCE_API_KEY=

# --- Clé API NASA FIRMS (Gratuite) ---
# Obtenir une clé sur : https://firms.modaps.eosdis.nasa.gov/api/map_key/
NASA_API_KEY=

# --- Intervalles de diffusion (en minutes) ---
# Intervalle de diffusion météo de routine
METEO_BROADCAST_INTERVAL=360

# Intervalle de vérification des alertes
ALERT_CHECK_INTERVAL=15

# Intervalle de reporting d'une alerte grave en cours (en minutes)
ALERT_REPORT_INTERVAL=60

# --- Niveau minimum d'alerte pour déclenchement (1=vert, 2=jaune, 3=orange, 4=rouge) ---
ALERT_TRIGGER_LEVEL=3

# --- Surveillance Normandie (14, 27, 50, 61, 76) ---
# Activer la surveillance automatique de toute la région Normandie
ENABLE_NORMANDIE_ALERTS=True

# --- Logging ---
LOG_LEVEL=INFO
LOG_FILE=logs/bot.log
